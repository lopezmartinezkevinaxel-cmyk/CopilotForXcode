-- AdminHub LocalScript (StarterGui)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")

local player = Players.LocalPlayer

-- Esperar remotes
local remFolder = ReplicatedStorage:WaitForChild("AdminHubRemotes")
local SetGod = remFolder:WaitForChild("SetGodMode")
local Rebirth = remFolder:WaitForChild("RequestRebirth")
local AutoTrain = remFolder:WaitForChild("RequestAutoTrain")
local SetSpeed = remFolder:WaitForChild("SetAdminSpeed")

-- Helper visual / funciones
local function make(parent, className, props)
    local obj = Instance.new(className)
    if props then
        for k,v in pairs(props) do obj[k] = v end
    end
    obj.Parent = parent
    return obj
end

-- Crear ScreenGui y Hub si no existe (evita duplicados)
local screenGui = script.Parent
if not screenGui:IsA("ScreenGui") then
    warn("Coloca este LocalScript dentro de StarterGui -> ScreenGui")
end

-- Hub principal
local Hub = make(screenGui, "Frame", {
    Name = "Hub",
    Size = UDim2.new(0, 300, 0, 300),
    AnchorPoint = Vector2.new(0.5,0.5),
    Position = UDim2.new(0.5, 0.5, 0.5, 0),
    BackgroundTransparency = 1,
})
local Panel = make(Hub, "Frame", {
    Name = "Panel",
    Size = UDim2.new(0, 300, 0, 300),
    BackgroundTransparency = 1,
})
-- Borde negro
local stroke = make(Panel, "UIStroke", {Color = Color3.fromRGB(0,0,0), Thickness = 2})

-- Header (arrastrar + toggle)
local Header = make(Panel, "TextButton", {
    Name = "Header",
    Size = UDim2.new(1,0,0,36),
    Position = UDim2.new(0,0,0,0),
    BackgroundTransparency = 1,
    Text = "HUB  ▼",
    TextColor3 = Color3.fromRGB(255,255,255),
    Font = Enum.Font.SourceSansBold,
    TextSize = 18,
})
-- Content
local Content = make(Panel, "Frame", {
    Name = "Content",
    Size = UDim2.new(1,0,1,-36),
    Position = UDim2.new(0,0,0,36),
    BackgroundTransparency = 1,
})
local layout = make(Content, "UIListLayout", {Padding = UDim.new(0,8), SortOrder = Enum.SortOrder.LayoutOrder})
Content.Padding = UDim.new(0,6)

-- Crear 7 botones
local names = {
    "Opt1_God", "Opt2_ToPortals", "Opt3_ToEggs",
    "Opt4_AFK", "Opt5_AutoRebirth", "Opt6_AutoTrain", "Opt7_AdminSpeed"
}
local buttons = {}

for i,name in ipairs(names) do
    local btn = make(Content, "TextButton", {
        Name = name,
        Size = UDim2.new(1, -12, 0, 40),
        BackgroundColor3 = Color3.fromRGB(0,120,255),
